{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=NexlyDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Key": "YOUR_SUPER_SECRET_KEY_MUST_BE_LONG",
    "Issuer": "NexlyAPI",
    "Audience": "NexlyClient",
    "DurationInMinutes": 60
  },
  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "StripeSettings": {
    "SecretKey": "sk_test_YOUR_STRIPE_KEY",
    "PublishableKey": "pk_test_YOUR_STRIPE_KEY"
  },
  "OpenAISettings": {
    "ApiKey": "sk-YOUR_OPENAI_KEY"
  }
}